# =============================================================================
# TrendRadarCN  ·  环境变量模板
# =============================================================================
# 用法:  复制本文件为 .env, 填入真实值即可。
#        run.py 启动时会自动加载, 无需手动 set / export。
#        .env 已在 .gitignore 里, 不会被提交。
# -----------------------------------------------------------------------------

# 提示: 所有值建议用双引号包起来, 即使是纯英文 (避免特殊字符意外触发解析)。
# python-dotenv 会自动剥外层引号, 值本身保持原样。

# ----- HTTP 代理 (可选) ------------------------------------------------------
# 用于访问 Google News / HuggingFace / arxiv 等被墙站点。
# 默认空 → 不走代理 (国内直连源照样能跑)。
# 支持 http:// 和 socks5:// 协议。
TRENDRADAR_PROXIES=""

# ----- 知乎 cookie (可选) ---------------------------------------------------
# 用于绕过知乎热榜的反爬。浏览器登录知乎后, F12 → Application
# → Cookies → 复制整行 (key1=val1; key2=val2; ...) 粘贴在引号内。
# 不配也行, 只是 zhihu 源会 401/403。
TRENDRADAR_ZHIHU_COOKIE=""

# ----- LLM 分类器 API key (可选) ---------------------------------------------
# 用于 ai-cn / ai-frontier 板的 LLM 自动打标签。
# 默认走 DeepSeek (api.deepseek.com), 也可改 base_url 走 OpenAI / 智谱 / Ollama 等。
# 不配 key 时自动降级到规则匹配, 板块照常工作。
TRENDRADAR_LLM_API_KEY=""
TRENDRADAR_LLM_BASE_URL="https://api.deepseek.com"
TRENDRADAR_LLM_MODEL="deepseek-chat"

# LLM 代理 (可选; 公司网络/被墙时用)
# 优先级: TRENDRADAR_LLM_PROXY > TRENDRADAR_PROXIES[0] > HTTPS_PROXY > 直连
# 一般留空, 自动复用 TRENDRADAR_PROXIES。除非你要给 LLM 单独指定不同代理。
TRENDRADAR_LLM_PROXY=""

# ----- SEC EDGAR 联系邮箱 (用 my-portfolio 板时需要) ------------------------
# SEC 风控要求 User-Agent 含真实联系方式, 否则 403 Forbidden。
# 格式: "<项目名> <你的邮箱>", 例如 "TrendRadarCN yourname@gmail.com"
SEC_USER_AGENT=""

# ----- 邮件推送 (可选; 配满 4 个必填字段即启用) -----------------------------
# 定时任务跑完 --board all 后, 把今日新文章发到你邮箱。
# 没配则 silent skip, 不影响抓取本身。
#
# 常见 provider 配置:
#   Gmail   : HOST=smtp.gmail.com  PORT=587  TLS=true  PASS=<App Password>
#             https://myaccount.google.com/apppasswords (需先开两步验证)
#             ⚠ 国内可能连不上, smtplib 不读 HTTPS_PROXY
#
#   QQ 邮箱  : HOST=smtp.qq.com    PORT=465  TLS=false PASS=<授权码>
#             mail.qq.com → 设置 → 账户 → POP3/SMTP 服务 → 生成授权码
#
#   163 邮箱 : HOST=smtp.163.com   PORT=465  TLS=false PASS=<客户端授权密码>
#             mail.163.com → 设置 → POP3/SMTP/IMAP → 开启服务并设密码
#
#   Outlook : HOST=smtp.office365.com PORT=587 TLS=true PASS=<账号密码>
#
SMTP_HOST=""              # smtp 服务器地址
SMTP_PORT="587"           # 587 (STARTTLS) 或 465 (SSL)
SMTP_USER=""              # 你的邮箱地址 (用作登录用户名)
SMTP_PASS=""              # ⚠ App Password / 授权码, 不是登录密码
SMTP_FROM=""              # 留空默认用 SMTP_USER
SMTP_TO=""                # 收件人, 多个用逗号分隔: a@x.com,b@y.com
SMTP_USE_TLS="true"       # 587 端口填 true; 465 端口填 false

# ----- 公网仪表盘 URL (推荐; 优先级最高) ------------------------------------
# 邮件页脚链接会用这个 URL, 任何设备/任何网络都能打开。
# 配置方法:
#   1. python run.py --snapshot-publish   一次, 把 docs/ 推到 GitHub
#   2. GitHub 仓库 Settings → Pages → Source: Deploy from a branch
#      → Branch: main / folder: /docs → Save
#   3. 等 1-2 分钟, GitHub 给你 https://<user>.github.io/<repo>/ 这种 URL
#   4. 把上一步拿到的 URL 填到下面 (末尾不要加 /)
TRENDRADAR_PUBLIC_URL=""

# ----- 仪表盘 URL (可选; 用于邮件页脚的链接) ---------------------------------
# 邮件正文底部会附上一个"打开本地仪表盘"的链接。默认 http://127.0.0.1:8001
# 只能从启动服务器的机器上打开, 手机/平板点了是死链。
# 解决: 设成你 PC 在 LAN 上的 IP, 例如 http://192.168.1.100:8001
# 查 IP: PowerShell 执行  ipconfig | findstr IPv4
# 同时需把 FastAPI 监听到 0.0.0.0 (run.py 现在已默认 0.0.0.0, 无需额外操作)。
# 首次启动 Windows 防火墙会弹窗 → 选"允许访问 (专用网络)"。
# 注意: 若已配置 TRENDRADAR_PUBLIC_URL, 它会优先生效, 本变量被忽略。
TRENDRADAR_DASHBOARD_URL=""

# ----- FastAPI 监听 (可选) --------------------------------------------------
# 默认 0.0.0.0 (LAN 内任意设备可访问)。改 127.0.0.1 = 仅本机可访问。
TRENDRADAR_HOST="0.0.0.0"
TRENDRADAR_PORT="8001"
